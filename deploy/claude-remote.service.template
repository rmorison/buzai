# buzai assistant — Claude Code Remote Control (--user systemd unit TEMPLATE)
#
# Copy to ~/.config/systemd/user/claude-remote.service, edit the paths/name,
# then:  systemctl --user daemon-reload && systemctl --user enable --now claude-remote
#        loginctl enable-linger "$USER"     # so it runs without an active login
# See deploy/README.md for the full install + secrets steps.

[Unit]
Description=buzai assistant — Claude Code Remote Control
After=network-online.target
Wants=network-online.target

# If the server ever hot-loops (e.g. exits immediately on a misconfig instead of sitting
# active-but-unregistered), surface it as a visible `failed` state rather than silent
# ~6x/min churn: >5 restarts in 5 min trips the start limit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# `claude remote-control` exits on SIGINT (its "Press Ctrl+C to stop"), NOT SIGTERM.
# Without this, `systemctl stop/restart` sends SIGTERM, claude ignores it, and systemd
# waits the full TimeoutStopSec before SIGKILL (a ~90s hang + a `failed` state). Send
# SIGINT instead, cap the wait, and treat a SIGINT exit as success.
KillSignal=SIGINT
TimeoutStopSec=20s
SuccessExitStatus=SIGINT

# Where you cloned the template (the assistant's workspace).
WorkingDirectory=%h/buzai

# Secrets live OUTSIDE the repo, mode 0600, beyond any file-write tool's reach.
# These are for LOCAL MCP connectors only. A managed-connector-only setup (all
# connectors via claude.ai — Gmail/Calendar/Drive/Todoist/etc., whose OAuth lives in
# ~/.claude/.credentials.json) has NONE: leave every line below commented.
#
# To add a local MCP connector: UNCOMMENT one line per connector you configure, and
# match the filename to your deploy/env/*.env file. NO leading '-': a missing file
# HARD-FAILS the unit (fail-closed) — do not add '-', which would let the service
# start with unset secrets.
#EnvironmentFile=%h/.config/buzai/secrets/email.env
#EnvironmentFile=%h/.config/buzai/secrets/xero.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# Where the private hub repo lives. %h/hubs is the default, so this line is only needed
# if your store is somewhere else — but if it IS somewhere else, it MUST be set HERE.
# A `--user` unit sources neither ~/.profile nor ~/.bashrc, so an export in a shell
# profile reaches your ssh session and never reaches the service: the assistant would
# read and write a different store than the one you inspect by hand, silently, with
# both looking correct. The preflight below prints the path it resolved on every start
# — compare it against `make hub-init` output if anything looks missing.
#Environment=BUZAI_HUBS_DIR=%h/hubs

# Refuse to start on a layout that can leak personal state: a real .env or personal hub
# content inside the checkout, a hub deploy key with loose perms or tracked by any repo,
# a credential helper on the public origin, or a hub path inside the checkout. Durability
# conditions (no remote, unpushed backlog, dirty hub tree) print WARN and DO NOT block
# start — with StartLimitBurst=5 above, failing on those would turn "knowledge is not
# backed up" into "the assistant is gone". Runs under the pinned, self-contained .venv
# Python (SETUP step 5), NOT the host's system python.
ExecStartPre=%h/buzai/.venv/bin/python %h/buzai/scripts/secrets_preflight.py

# Re-verify that the hub remote is still PRIVATE, and do it BEFORE anything pushes.
# The verdict is cached for an hour inside the hub repo, and a repository can be flipped
# to public through a web UI with the clone URL unchanged — so without this line a
# restart would keep pushing against a verdict nobody re-checked. This runs a fresh
# anonymous probe and rewrites or EVICTS the cached verdict; a non-private answer leaves
# no usable cache entry, so the pushes below refuse and queue instead of proceeding.
# The leading '-' means the outcome can never affect service start: a repo that is not
# yet created, a network that is down, a verdict of "public" — none of those are reasons
# to take the assistant off the air, they are reasons not to push. Bounded: every probe
# carries PROBE_TIMEOUT_SECONDS (20s) and the ssh-alias resolution 10s.
ExecStartPre=-%h/buzai/.venv/bin/python %h/buzai/scripts/hub_remote.py

# The start job now spans the preflight, a privacy re-verification and two pushes, and
# every one of them is network-facing. systemd's 90s default would kill a start whose
# probes are merely slow — and killing it stops the ExecStart server that is already
# running and serving, which is precisely backwards. Each command is internally bounded,
# so this only has to exceed their sum on a bad-but-real day (an unreachable remote is
# roughly two minutes of timeouts); a generous value costs nothing because the assistant
# is live throughout, while a tight one takes a working assistant down.
TimeoutStartSec=600s

# Long-lived remote-control SERVER (sessions attach on demand). Do NOT use
# `--spawn session` here: single-session-exits-on-complete + Restart=always is the
# silent-prompt-loss footgun (a prompt sent during the respawn window is swallowed).
# `--spawn=same-dir` PINS the spawn mode so the first-run interactive "Spawn mode
# [1/2]" prompt can never block a headless start. (The other first-run prompt,
# "Enable Remote Control? (y/n)", has no flag — prime it once interactively per
# SETUP §6 before enabling this unit, or the service starts but never registers.)
ExecStart=%h/.local/bin/claude remote-control --name buzai-assistant --spawn=same-dir

# The "retried at service start" guarantee, actually wired. A push can fail for hours —
# an expired deploy key or token, an offline box — and the commit is then durable locally
# but not off-box; nothing drains that backlog except the next successful write, a manual
# `make hub-push`, or this. The second call is the review dispositions: `git push` does
# not carry refs/notes/*, so they need their own push or an R8 restore resurfaces every
# already-approved change as pending.
#
# ExecStartPost, so the server above is already up and serving before any of it runs. The
# leading '-' means failure can never affect start. `sh -c` with '&&' is deliberate and
# matches `make hub-push`: if the commits could not be pushed, the notes ref must NOT go
# either — a note must never reach the remote ahead of the correction commit it refers
# to. Both calls re-verify privacy themselves and refuse unless the verdict is PRIVATE
# (the ExecStartPre above has just refreshed it), and both are bounded — 60s per push,
# 30s per local git call — so neither can hang this unit.
ExecStartPost=-/bin/sh -c '%h/buzai/.venv/bin/python %h/buzai/scripts/hub_commit.py --retry-push && %h/buzai/.venv/bin/python %h/buzai/scripts/hub_review.py --push-notes'

Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
