# EXAMPLE — copy to ~/.config/buzai/secrets/email.env (OUTSIDE this repo), fill in
# real values, and chmod 0600. The real file is never committed and must live
# outside the workspace tree so the assistant's own file-write tools cannot reach it.
#
# Variable names are safe to ship; real values are NOT. Replace every CHANGEME.
IMAP_HOST=CHANGEME
IMAP_USER=CHANGEME
IMAP_PASSWORD=CHANGEME
SMTP_HOST=CHANGEME
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
